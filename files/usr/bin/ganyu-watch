#!/bin/sh
# ganyu-watch —— 后台体检 + 出事自动断网（fail-closed）
#
# 每 60 秒跑一次 /usr/bin/ganyu-status --verdict，按下面规则处置：
#
#   1) 先自愈：模块丢了 modprobe、规则丢了 restart 对应服务（每轮最多一次）
#   2) 同一个致命项连续 3 轮都 fail → ganyu-guard kill，把 WAN 整个停掉
#      （只停 WAN：SSH / LuCI / DNS 全在 LAN 上，照常可用）
#   3) 计数停滞（规则在、WAN 有流量、但三个计数器连续 3 轮不动）也按致命处理
#      —— 这就是"静默失效"，光看累计值永远发现不了
#   4) killswitch=0 时只记录、不动网（调试用），默认 1
#
# 恢复只有两条路：LuCI 状态页的「恢复」按钮（/usr/bin/ganyu-rearm），
# 或者 `ganyu-guard rearm`。不自动重试，避免来回抽。

PATH=/usr/sbin:/usr/bin:/sbin:/bin

VERDICT=/tmp/ganyu-verdict
STATE=/tmp/ganyu-watch.state
EVENTS=/tmp/ganyu-events.log
REARM=/tmp/ganyu-rearm
ALARM=/tmp/ganyu-alarm
CNT=/tmp/ganyu-watch.cnt

# 连续几轮才动手（60 秒一轮 → 3 轮 = 3 分钟）
CONFIRM=3

# 这些项 fail 会断网。P0（核心链路断了等于裸奔）+ P1（已确认的泄露：
# DNS 劫持规则没了、DoT 放行了、IPv6 出去了），按"宁停勿漏"处理。
# 注意这里只认 fail：像"规则在但还没命中"这类是 warn，不会触发断网。
KILL_IDS="ipid_ko ipid_rule ttl_rule tcpts ua2f_run v6 dns dot"

log() { logger -t ganyu-watch "$*"; }

event() { # event 级别 内容
	printf '%s [%s] %s\n' "$(date '+%m-%d %H:%M:%S')" "$1" "$2" >>"$EVENTS"
	# 环形：只留最近 200 行（/tmp 是内存，不磨 flash）
	if [ "$(wc -l <"$EVENTS" 2>/dev/null)" -gt 200 ] 2>/dev/null; then
		tail -n 200 "$EVENTS" >"$EVENTS.tmp" && mv "$EVENTS.tmp" "$EVENTS"
	fi
	log "$1: $2"
}

is_up() { ifstatus wan 2>/dev/null | grep -q '"up": true'; }

killed() { nft list table ip ganyu_kill >/dev/null 2>&1; }

# 自愈：看到哪个坏了就修哪个，每轮每种只修一次
heal() {
	local id="$1"
	case "$id" in
		ipid_ko)
			modprobe rkp-ipid 2>/dev/null && event 自愈 'modprobe rkp-ipid'
			;;
		ipid_rule)
			/etc/init.d/rkp-ipid-mark restart >/dev/null 2>&1 && event 自愈 '重启 rkp-ipid-mark'
			;;
		ttl_rule|dot)
			/etc/init.d/ganyu-guard restart >/dev/null 2>&1 && event 自愈 '重启 ganyu-guard'
			;;
		ua2f_run)
			/etc/init.d/ua2f restart >/dev/null 2>&1 && event 自愈 '重启 ua2f'
			;;
	esac
}

# 从 $VERDICT 里挑出 fail 的 id
fails() {
	awk '$2 == "fail" { print $1 }' "$VERDICT" 2>/dev/null
}

# 读写连续计数：state 文件每行 "id count"
bump() { # bump id -> 打印新计数
	local id="$1" cur=0 rest=''
	[ -f "$STATE" ] && rest=$(awk -v k="$id" '$1 != k' "$STATE")
	cur=$(awk -v k="$id" '$1 == k { print $2 }' "$STATE" 2>/dev/null)
	[ -n "$cur" ] || cur=0
	cur=$((cur + 1))
	printf '%s\n' "$rest" "$id $cur" | grep -v '^$' >"$STATE.tmp"
	mv "$STATE.tmp" "$STATE"
	echo "$cur"
}

clear_one() {
	local id="$1"
	[ -f "$STATE" ] || return 0
	awk -v k="$id" '$1 != k' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

reset_all() { : >"$STATE"; : >"$CNT"; }

stalled() { # 计数停滞判定：WAN 在、有流量、三个计数器两轮完全一样	local ipd tt ua last
	# 直接从 nft/iptables 再取一次，避免依赖 verdict 格式
	ipd=$(iptables -t mangle -L IPID_MOD -n -v 2>/dev/null | awk '/MARK/ {print $1; exit}')
	tt=$(nft list table ip ganyu 2>/dev/null | awk '/ttl set 64/ {for (i = 1; i <= NF; i++) if ($i == "packets") print $(i + 1)}' | head -n 1)
	ua=$(nft list table inet ua2f 2>/dev/null | awk '/counter packets/ {for (i = 1; i <= NF; i++) if ($i == "packets") v = $(i + 1)} END {print (v == "" ? 0 : v)}')
	[ -n "$ipd" ] || ipd=0
	[ -n "$tt" ] || tt=0
	[ -n "$ua" ] || ua=0
	last="${ipd},${tt},${ua}"
	if [ "$(cat "$CNT" 2>/dev/null)" = "$last" ]; then
		echo 'stall'
	else
		printf '%s' "$last" >"$CNT"
		echo 'ok'
	fi
}

# 僵尸关联自愈
#
# 2026-11-25 真实事故：mt76x2e 固件 MCU 超时（dmesg 里
# `MCU message 1f (seq 6) timed out` → `ieee80211 phy1: Hardware restart was requested`），
# 固件自己重启后 wpa_supplicant 仍认为 "Connected"，`iw dev phy1-sta0 link`
# 也显示连着，但网关 ARP 是 INCOMPLETE —— 一个包都出不去。这种状态卡很久，
# 只有 ifdown/ifup 才能重新关联。所以这里盯"网关通不通"，而不是"接口 up 不 up"。
guard_link() {
	local gw n
	gw=$(ip -4 route 2>/dev/null | awk '/^default/ {print $3; exit}')
	[ -n "$gw" ] || return 0            # 门禁窗口内 WAN 本来就该是断的，别管
	is_up || return 0

	if ping -c 2 -W 2 "$gw" >/dev/null 2>&1; then
		clear_one link
		return 0
	fi

	n=$(bump link)
	event 警告 "WAN 口 up 但网关 $gw 不通（第 $n 次）"
	[ "$n" -ge 3 ] || return 0

	event 自愈 "疑似僵尸关联（固件重启后 wpa_supplicant 仍以为连着），正在重连 WAN"
	ubus call network.interface.wan down >/dev/null 2>&1
	sleep 5
	ubus call network.interface.wan up >/dev/null 2>&1
	clear_one link
}

cycle() {
	local id n reason=''

	# 手动恢复标记
	if [ -f "$REARM" ]; then
		rm -f "$REARM"
		/etc/init.d/ganyu-guard rearm >/dev/null 2>&1
		reset_all
		event 恢复 '收到手动恢复请求，已重新启用 WAN'
		return 0
	fi

	# 先看网络本身通不通（僵尸关联），再看规则对不对
	guard_link

	[ -f "$VERDICT" ] || /usr/bin/ganyu-status --verdict >/dev/null 2>&1

	# 自愈 + 计数
	for id in $(fails); do
		heal "$id"
	done

	# 停滞只在 WAN 在线的判断（门禁窗口内 WAN 本来就该是断的）
	if is_up && [ "$(stalled)" = "stall" ]; then
		n=$(bump stall)
		event 警告 "计数器连续 $n 轮没动，但 WAN 在线（疑似规则被绕过）"
		if [ "$n" -ge "$CONFIRM" ]; then reason="计数器停滞 ${n} 轮（规则可能被绕过）"; fi
	else
		clear_one stall
	fi

	for id in $KILL_IDS; do
		if grep -q "^$id fail " "$VERDICT" 2>/dev/null; then
			n=$(bump "$id")
			if [ "$n" -ge "$CONFIRM" ] && [ -z "$reason" ]; then
				reason="$(grep "^$id fail " "$VERDICT" | head -n 1 | cut -d' ' -f3-)（连续 $n 轮）"
			fi
		else
			clear_one "$id"
		fi
	done

	if [ -n "$reason" ]; then
		if [ "$(uci -q get ganyu.main.killswitch)" = "1" ] && ! killed; then
			/etc/init.d/ganyu-guard killit "$reason" >/dev/null 2>&1
			event 断网 "已断开 WAN：$reason"
		elif [ "$(uci -q get ganyu.main.killswitch)" != "1" ]; then
			event 警告 "（killswitch=0，只记录）本应断网：$reason"
		fi
	fi
}

main() {
	# 开机先给系统 2 分钟把 wan / 服务都拉起来，避免自己把正常的启动判成故障
	sleep 120
	event 启动 '体检守护已启动（60 秒一轮）'
	while :; do
		cycle
		sleep 60
	done
}

main
