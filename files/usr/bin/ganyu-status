#!/bin/sh
# ganyu-status —— 反检测链路实时状态（只读）
#
# 供 LuCI 视图 /www/luci-static/resources/view/ganyu/status.js 调用。
# 全部取数都做了容错：没装包、没建表、没接口、没 STA 时一律显示 n/a，
# 脚本本身永远 exit 0，不会因为某一条命令失败就把整个页面拖垮。

PATH=/usr/sbin:/usr/bin:/sbin:/bin

# ---- 取数 ----------------------------------------------------------------

# IPID：内核模块是否加载
ko_state() {
	if [ -d /sys/module/rkp_ipid ]; then
		echo "已加载"
	else
		echo "未加载"
	fi
}

# IPID：OUTPUT / FORWARD 上是否挂着 IPID_MOD
jump_state() {
	local o f
	o=$(iptables -t mangle -S OUTPUT 2>/dev/null | grep -c -- '-j IPID_MOD')
	f=$(iptables -t mangle -S FORWARD 2>/dev/null | grep -c -- '-j IPID_MOD')
	[ -n "$o" ] || o=0
	[ -n "$f" ] || f=0
	if [ "$o" -gt 0 ] 2>/dev/null && [ "$f" -gt 0 ] 2>/dev/null; then
		echo "OUTPUT + FORWARD 已挂"
	else
		echo "未挂载 (OUT=$o FWD=$f)"
	fi
}

# IPID：MARK 规则命中的包数
ipid_pkts() {
	local n
	n=$(iptables -t mangle -L IPID_MOD -n -v 2>/dev/null | awk '/MARK/ {print $1; exit}')
	[ -n "$n" ] || n=0
	echo "$n"
}

# nft 表 ganyu 的各类计数，输出 key=value 便于后面读取
nft_counts() {
	nft list table ip ganyu 2>/dev/null | awk '
	/counter packets/ {
		n = 0
		for (i = 1; i <= NF; i++)
			if ($i == "packets") n = $(i + 1)
		if ($0 ~ /to :53/) {
			if ($0 ~ /udp/) du = n; else dt = n
		}
		if ($0 ~ /to :123/) nt = n
		if ($0 ~ /ttl set 64/) tt = n
		if ($0 ~ /dport 853/) dk = n
	}
	END {
		printf "dns_udp=%d\ndns_tcp=%d\nntp=%d\nttl=%d\ndot=%d\n",
			(du == "" ? 0 : du), (dt == "" ? 0 : dt),
			(nt == "" ? 0 : nt), (tt == "" ? 0 : tt), (dk == "" ? 0 : dk)
	}'
}

# ganyu 表是否存在
nft_table() {
	if nft list table ip ganyu >/dev/null 2>&1; then
		echo "table ip ganyu 已建立"
	else
		echo "table ip ganyu 不存在（/etc/init.d/ganyu-guard start）"
	fi
}

# UA2F
ua2f_state() {
	local p
	p=$(pidof ua2f 2>/dev/null | awk '{print $1}')
	if [ -n "$p" ]; then
		echo "running (pid $p)"
	else
		echo "stopped"
	fi
}

ua2f_pkts() {
	local n
	n=$(nft list table inet ua2f 2>/dev/null | awk '/counter packets/ {
		for (i = 1; i <= NF; i++) if ($i == "packets") v = $(i + 1)
	} END { print (v == "" ? 0 : v) }')
	[ -n "$n" ] || n=0
	echo "$n"
}

# 门户登录
ybu_state() {
	local e
	e=$(uci -q get ybu.main.enabled)
	[ -n "$e" ] || e='?'
	echo "enabled=$e"
}

# IPv6 转发封锁状态（v6 走 SLAAC 每台设备一个全局地址，绕开 v4 那套伪装）
v6_state() {
	local out
	if ! nft list table ip6 ganyu >/dev/null 2>&1; then
		echo '未封锁（ip6 ganyu 表不存在）'
		return
	fi
	out=$(nft list table ip6 ganyu 2>/dev/null | awk '/counter packets/ { n = $3; if (n == "") n = "?"; print n; exit }')
	[ -n "$out" ] || out='?'
	echo "转发已 DROP（已拦 $out 包）"
}

# flow offloading（必须为 0，否则 nat 加速会绕过 POSTROUTING，rkp-ipid 收不到包）
offload_state() {
	local a b
	a=$(uci -q get firewall.@defaults[0].flow_offloading)
	b=$(uci -q get firewall.@defaults[0].flow_offloading_hw)
	[ -n "$a" ] || a='未设置'
	[ -n "$b" ] || b='未设置'
	echo "$a / hw $b"
}

# 无线 STA 与 WAN
sta_info() {
	# iwinfo 的输出列位置不固定（phy1-sta0 ESSID: "YBU" / Mode: Client  Channel: 44 ...），
	# 所以按标签取子串，不按 $N 取字段。
	iwinfo phy1-sta0 info 2>/dev/null | awk '
		/ESSID:/   { i = index($0, "ESSID:");   e = substr($0, i + 6); sub(/^ +/, "", e) }
		/Signal:/  { i = index($0, "Signal:");  s = substr($0, i + 7); sub(/^ +/, "", s); sub(/ .*/, "", s) }
		/Channel:/ { i = index($0, "Channel:"); c = substr($0, i + 8); sub(/^ +/, "", c); sub(/ .*/, "", c) }
		/Link Quality:/ {
			i = index($0, "Link Quality:"); q = substr($0, i + 13); sub(/^ +/, "", q); sub(/ .*/, "", q)
		}
		END {
			if (e == "") { print "未连接"; exit }
			printf "%s  %s dBm  ch%s  信号质量 %s", e, s, c, q
		}'
}

wan_ip() {
	local ip
	ip=$(ifstatus wan 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	[ -n "$ip" ] || ip='无地址'
	echo "$ip"
}

# 最近日志
recent_log() {
	logread 2>/dev/null | grep -iE 'ganyu|rkp-ipid|ybu-login|ua2f' | tail -n 5
}

# ---- 输出 ----------------------------------------------------------------

main() {
	local c
	c=$(nft_counts)

	printf '反检测状态  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
	echo '────────────────────────────────────────────'

	printf 'IPID  内核模块   %s\n' "$(ko_state)"
	printf 'IPID  规则链     %s\n' "$(jump_state)"
	printf 'IPID  已改写     %s 包\n' "$(ipid_pkts)"
	echo

	printf 'nft   %s\n' "$(nft_table)"
	printf 'DNS   劫持 53     UDP %s / TCP %s 包 → 本机 dnsmasq\n' \
		"$(echo "$c" | sed -n 's/^dns_udp=//p')" \
		"$(echo "$c" | sed -n 's/^dns_tcp=//p')"
	printf 'NTP   强制本地     %s 包 → 本机 ntpd\n' "$(echo "$c" | sed -n 's/^ntp=//p')"
	printf 'TTL   统一 64      %s 包\n' "$(echo "$c" | sed -n 's/^ttl=//p')"
	printf 'DoT   853 封锁     %s 包\n' "$(echo "$c" | sed -n 's/^dot=//p')"
	printf 'IPv6  转发封锁     %s\n' "$(v6_state)"
	printf '流量卸载 flow offloading  %s（必须 0）\n' "$(offload_state)"
	echo

	printf 'UA    ua2f        %s\n' "$(ua2f_state)"
	printf 'UA    队列放行     %s 包\n' "$(ua2f_pkts)"
	printf '门户  ybu-login   %s\n' "$(ybu_state)"
	echo

	printf '无线  STA         %s\n' "$(sta_info)"
	printf '网络  WAN         %s\n' "$(wan_ip)"
	echo

	echo '最近日志'
	echo '────────────────────────────────────────────'
	recent_log
}

main
exit 0
