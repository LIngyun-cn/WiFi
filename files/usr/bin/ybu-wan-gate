#!/bin/sh
#
# 起网门禁（+ 手动抢跑）
#
# 背景（2026-11-25 用户指出的真问题）：
#   宿舍 23:00 断电、次日 5–6 点来电。路由器一上电就 wpa 关联 + DHCP + 门户认证，
#   网管侧看到的是「某个 MAC 每天 05:0x 准点出现，误差几十秒」—— 这是行为层铁证。
#   只延迟「登录」没用：没认证的设备照样 DHCP/ARP，一样是「每天 5 点准时上线」。
#   所以在 WAN 这一层推迟起网（network.wan.auto=0，由 98-wan-sta 写入）。
#
# 现在只有两条通路能结束等待：
#   1) 到点：在 06:45–09:15（周末 08:30–11:00）里按分钟均匀抽一个时刻，到了就 ifup wan。
#   2) 手动：门禁期间用手机打开 http://192.168.1.1/cgi-bin/wake，落一个标记文件，
#      本脚本 10 秒内看到就立刻 ifup wan。这是"人真的要用网了"最可靠的信号 ——
#      人自己点了一下，比猜 MAC 靠谱得多。
#
# 明确不做（2026-11-25 删掉）：曾用"AP 上出现新 MAC ⇒ 人在场"来做早触发，实测失败：
#   刷完机重启，用户手机在 2 分 10 秒后才自动重连，被当成"人来了"，把当天唯一一次
#   抢跑机会用掉了 —— 等于把"每天准点上线"又带回来了。原因很朴素：宿舍里就那几台设备，
#   手机/平板会自己重连（人在睡觉也连），笔记本不会自己开机，MAC 信号没有信息量。
#
# 起网之后保持连线、不回头；门户会话掉了由 ybu-login daemon 自动重登。

. /lib/functions.sh

log() { logger -t ybu-wan-gate "$*"; echo "$*"; }

ifup_wan() {
	local i
	for i in 1 2 3; do
		ifup wan >/dev/null 2>&1 && return 0
		sleep 10
	done
	return 1
}

W=$(/usr/bin/ybu-login wakewait 2>/dev/null)
case "$W" in
'' | *[!0-9]*) W=120 ;;
esac
[ "$W" -gt 14400 ] && W=14400

log "起网门禁：本次等 ${W} 秒（$((W / 60)) 分钟）再拉起 WAN；需要立刻上网就打开 http://192.168.1.1/cgi-bin/wake"

# 清掉上一轮遗留的手动起网标记（否则一开机会立刻起网）
rm -f /tmp/ybu-gate-wake

i=0
manual=0
while [ "$i" -lt "$W" ]; do
	if [ -f /tmp/ybu-gate-wake ]; then
		rm -f /tmp/ybu-gate-wake
		manual=1
		log "手动请求起网（LAN 页面 /cgi-bin/wake），跳过剩余 $((W - i)) 秒"
		break
	fi
	sleep 10
	i=$((i + 10))
done

if ifup_wan; then
	if [ "$manual" = "1" ]; then
		log "WAN 已拉起（手动请求）"
	else
		log "WAN 已拉起（门禁结束）"
	fi
else
	log "WAN 拉起失败，再试一次 ifup wan"
	ifup wan >/dev/null 2>&1
fi
exit 0
