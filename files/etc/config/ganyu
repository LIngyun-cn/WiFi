config main 'main'
	# 总开关：0 时 start() 只建空链，不生效任何规则
	option enabled '1'
	# LAN 侧接口（dns 劫持 / ntp 重定向只对这个口进来的包生效）
	option lan_iface 'br-lan'

	# 1 = 把客户端的 53 全部劫持到本地 dnsmasq（收敛 resolver 指纹）
	option dns_hijack '1'
	# 1 = 封 853（DoT），防止绕过上面的劫持
	option block_dot '1'
	# 1 = 封已知公共 DoH 解析器的 443（Cloudflare/Google/Quad9/AdGuard/
	#     OpenDNS）。DoH 把查询塞进 HTTPS，网关看不到内容，等于绕开上面的
	#     53 劫持；封掉这些 IP 的 443 只是让"客户端想用 DoH"这条路走不通，
	#     同一 IP 上的其它端口不受影响。
	option block_doh '1'
	# 1 = 封 UDP 443（QUIC / HTTP3）。默认关：网页会更慢一点（退回 TCP），
	#     而它带来的收益只是"流量形态更一致"。想更严格可以打开。
	option block_quic '0'
	# 1 = 客户端 123 重定向到本地 ntpd
	option block_ntp '1'
	# 1 = 本地 ntpd 对外提供服务（重定向才有着落）
	option ntp_local '1'
	# 1 = POSTROUTING 把 TTL 统一成 64（xt_HL，iptables-mod-ipopt 已装）
	option ttl_unify '1'
	# 1 = Flash/AC 注入特征拦截（需要 iptables-mod-filter，默认关）
	option ac_probe '0'
	# 1 = 禁止 IPv6 转发（默认开）。理由：rkp-ipid / ttl 统一 / ua2f 全是 v4-only，
	#     而 IPv6 走 SLAAC 时每台设备一个全局地址、不需要 NAT，网关按源地址就能
	#     逐台识别（EUI-64 里还带 MAC）。实测目前校园网没有 v6 出口，这条现在
	#     零代价；哪天学校开了 v6，它保证不会静默泄漏成"三台机器各自上网"。
	option block_ipv6 '1'
