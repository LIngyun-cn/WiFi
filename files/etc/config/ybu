config main 'main'
	option enabled '0'
	# 学号（不含前缀）
	option account ''
	# 密码。默认按明文发；若门户要求 base64，把 password_base64 设 1
	option password ''
	option password_base64 '0'
	# 部分锐捷部署要求账号带前缀，如 ',0,'；实测本校本部不需要，留空即可
	option account_prefix ''
	option portal 'http://10.10.252.1:801/eportal/'
	# 在线探针：正常时返回空体最理想（generate_204 这一类）。
	# 别用带大量正文的地址当探针 —— 正文里的 login/认证 字样会让"已联网"被误判成"要登录"。
	option probe_url 'http://www.gstatic.com/generate_204'
	# WAN 接入方式：sta = radio1 无线连校园网 YBU；wired = 网线插墙口走 eth0.1
	# 切换用 ybu-login mode sta|wired，改完 reboot 生效
	option wan_mode 'sta'
	# 探测用的出口接口（wan / wwan / 你自建的 interface 名）
	option interface 'wan'
	option interval '60'
	# WAN 口要克隆成的 MAC（复制你 PC 的 MAC 用；不填就用网卡原始 MAC）
	option wan_mac ''
	# ── 起网门禁 ──────────────────────────────────────────────────
	# 宿舍 23:00 断电、次日 5–6 点来电。如果一上电就起网+认证，网管看到的是
	# 「同一 MAC 每天 05:0x 准点出现」，这是行为层铁证，比协议指纹好抓得多。
	# wan_gate=1 时：network.wan.auto 被设成 0，开机后由 ybu-wan-gate 睡到一个
	# 从下面区间里抽的随机时刻，再 ifup wan。
	option wan_gate '1'
	# 工作日 / 周末的"起床区间"（HHMM）。按分钟均匀采样，天天不同。
	option wake_from '0645'
	option wake_to '0915'
	option wake_from_weekend '0830'
	option wake_to_weekend '1100'
	# 连上即插队：门禁等待期间只要有客户端连上我们的 AP，就立刻起网。
	# 这是最常用的通路 —— 你醒了手机连上 Wi-Fi，一分钟内就有网，不用点任何东西。
	# 代价：早上通电后手机若自己切回我们的 AP，路由器会跟着上线（约 5:0x）。
	# 判断是小概率、且比"手机挂在有信号没外网的 Wi-Fi 上"更可接受，故默认开。
	# 设成 0 就只剩"到点"和"手动"两条路。
	option early_trigger '1'
	# 门禁期间需要立刻上网（比如还没到点，但你已经在用网线）：手机/电脑打开
	# http://192.168.1.1/cgi-bin/wake —— 5 秒内起网，然后自动过门户认证。