#!/bin/sh /etc/rc.common
# ganyu-guard —— 校园网"别被认出来"的一套规则
#
#   dns_hijack   把 LAN 客户端的 53（udp/tcp）重定向到本地 dnsmasq
#                → 客户端自设 DNS 失效，resolver 指纹统一
#   block_dot    封 853（DoT），防止绕过上面的重定向
#   block_ntp    客户端 123 重定向到本地 ntpd
#   ttl_unify    postrouting 把 TTL 统一成 64 → 藏住"经过几跳"
#   ac_probe     Flash/AC 注入特征拦截（默认关，需 iptables-mod-filter）
#
# 全部规则写在自己独立的 nft 表 ip ganyu 里，不碰 fw4 的 inet fw4，
# 也不依赖 xt_REDIRECT/xt_HL —— 实测这台 24.10.8 上 iptables-nft 做
# nat REDIRECT 会报 "Extension REDIRECT revision 0 not supported"，
# 而 nft 原生 `redirect to :53` / `ip ttl set 64` 都正常。
#
# 注意 1：rc.common 判断的是「变量非空」，这里绝不能写 USE_PROCD=0，
#        否则 start() 会被 procd 分支覆盖成空壳（rkp-ipid-mark 踩过）。
# 注意 2：本文件必须是 UTF-8 无 BOM，带 BOM 会导致 shebang 失效。

START=98
STOP=11
EXTRA_COMMANDS="status"
EXTRA_HELP="	status	打印 nft 表与命中计数"

CONF=ganyu
TABLE=ganyu
AC_CHAIN=GANYU_AC
V6_CHAIN=drop6
IN_CHAIN=gin

# 已知的公共 DoH 解析器。只封这些 IP 的 443，不动其它端口。
DOH_V4="1.1.1.1, 1.0.0.1, 8.8.8.8, 8.8.4.4, 9.9.9.9, 149.112.112.112, 94.140.14.14, 94.140.15.15, 208.67.222.222, 208.67.220.220"

c() { uci -q get "${CONF}.main.$1"; }
log() { logger -t ganyu-guard "$*"; }
on() { [ "$(c "$1")" = "1" ]; }

nft_run() { nft "$@" >/dev/null 2>&1; }

rules_up() {
	local lan

	# 先删后建，天然幂等
	nft delete table ip "$TABLE" 2>/dev/null
	if ! nft add table ip "$TABLE"; then
		log "ERROR: nft add table 失败"
		return 1
	fi
	nft "add chain ip $TABLE pre { type nat hook prerouting priority dstnat; policy accept; }" ||
		log "ERROR: 建 pre 链失败"
	nft "add chain ip $TABLE post { type filter hook postrouting priority mangle; policy accept; }" ||
		log "ERROR: 建 post 链失败"

	lan=$(c lan_iface)
	[ -n "$lan" ] || lan=br-lan

	# input 兜底：53 / 123 只对本机 loopback 与 LAN 开放。
	# 原因：ntpd 在 enable_server=1 时用 `ntpd -n -N -l` 监听 :::123（全接口），
	# dnsmasq 也会绑到 WAN 地址上；现在靠 fw4 的 wan zone input=REJECT 挡着，
	# 但那是另一张表，只要有人动过防火墙就会漏出"这台设备在对外提供
	# DNS/NTP 服务"这个特征。这里在 ganyu 表里再兜一层。
	# 必须放行 lo —— 路由器自己的进程查 127.0.0.1:53 也从 input 走，
	# 拦了它 = 路由器自己也解析不了（第一次部署就踩了：nslookup 全超时）。
	if nft "add chain ip $TABLE $IN_CHAIN { type filter hook input priority filter; policy accept; }"; then
		nft_run "add rule ip $TABLE $IN_CHAIN iifname { \"$lan\", \"lo\" } counter accept"
		# 本机服务端口：53 dnsmasq / 123 ntpd / 67 DHCP / 22 dropbear /
		# 80,443 uhttpd / 7681 ttyd。fw4 的 wan zone 已经 REJECT，这里是
		# "fw4 被人改过/重载失败" 时的第二道闸。
		# 不能拦 udp 68 —— 那是我们作为 DHCP 客户端收 OFFER/ACK 的端口。
		nft_run "add rule ip $TABLE $IN_CHAIN udp dport { 53, 67, 123 } counter drop"
		nft_run "add rule ip $TABLE $IN_CHAIN tcp dport { 22, 53, 80, 443, 7681 } counter drop"
	else
		log "ERROR: 建 input 兜底链失败"
	fi

	if on dns_hijack; then
		nft_run add rule ip "$TABLE" pre iifname "$lan" udp dport 53 counter redirect to :53
		nft_run add rule ip "$TABLE" pre iifname "$lan" tcp dport 53 counter redirect to :53
		log "dns_hijack: $lan 53/udp+tcp -> 本机 dnsmasq"
	fi

	if on block_ntp; then
		nft_run add rule ip "$TABLE" pre iifname "$lan" udp dport 123 counter redirect to :123
		log "block_ntp: $lan 123/udp -> 本机 ntpd"
	fi

	if on ttl_unify; then
		nft_run add rule ip "$TABLE" post counter ip ttl set 64
		log "ttl_unify: TTL -> 64"
	fi

	if on block_dot; then
		nft_run add rule ip "$TABLE" post tcp dport 853 counter drop
		log "block_dot: 853/tcp 已封"
	fi

	if on block_doh; then
		nft_run "add rule ip $TABLE post ip daddr { $DOH_V4 } tcp dport 443 counter drop"
		nft_run "add rule ip $TABLE post ip daddr { $DOH_V4 } udp dport 443 counter drop"
		log "block_doh: 已知 DoH 解析器的 443 已封"
	fi

	if on block_quic; then
		nft_run add rule ip "$TABLE" post udp dport 443 counter drop
		log "block_quic: UDP 443（QUIC/HTTP3）已封"
	fi

	v6_rules
	ac_rules
}

# IPv6 兜底：本套规则（rkp-ipid / ttl 统一 / ua2f）全是 v4-only，而 v6 在
# SLAAC 下每台设备一个全局地址、不经 NAT，网关按源地址就能逐台识别，
# 等于"检测免检通道"。所以直接把 v6 转发全封 —— 要么全走 v4（受我们控制），
# 要么别走。实测当前校园网无 v6 出口，这条零代价。
v6_rules() {
	nft delete table ip6 "$TABLE" 2>/dev/null
	on block_ipv6 || return 0
	if ! nft add table ip6 "$TABLE"; then
		log "ERROR: 建 ip6 $TABLE 表失败"
		return 1
	fi
	# 链名千万别叫 fwd：nft >= 1.0.9 把 fwd 当语句关键字，会报
	#   "syntax error, unexpected fwd, expecting string or last"
	if ! nft "add chain ip6 $TABLE $V6_CHAIN { type filter hook forward priority filter; policy accept; }"; then
		log "ERROR: 建 ip6 $V6_CHAIN 链失败，IPv6 未被封锁"
		nft delete table ip6 "$TABLE" 2>/dev/null
		return 1
	fi
	if nft add rule ip6 "$TABLE" "$V6_CHAIN" counter drop; then
		log "block_ipv6: IPv6 转发已全部 DROP"
	else
		log "ERROR: 加 ip6 drop 规则失败，IPv6 未被封锁"
		return 1
	fi
}

# Flash/AC 特征串：nft 没有 string 匹配器，这条只能留在 iptables
ac_rules() {
	iptables -t mangle -N "$AC_CHAIN" 2>/dev/null
	iptables -t mangle -F "$AC_CHAIN" 2>/dev/null
	iptables -t mangle -C FORWARD -j "$AC_CHAIN" 2>/dev/null ||
		iptables -t mangle -A FORWARD -j "$AC_CHAIN"

	on ac_probe || return 0

	# 材料里的 --algobm 是错的，必须 --algo bm
	if iptables -t mangle -A "$AC_CHAIN" -p tcp --sport 80 --tcp-flags ACK ACK \
		-m string --algo bm --string ' src="http://1.1.1.' -j DROP 2>/dev/null; then
		log "ac_probe: 特征串拦截已启用"
	else
		log "ac_probe: 需要 iptables-mod-filter（xt_string），当前缺失"
	fi
}

rules_down() {
	nft delete table ip "$TABLE" 2>/dev/null
	nft delete table ip6 "$TABLE" 2>/dev/null
	while iptables -t mangle -C FORWARD -j "$AC_CHAIN" 2>/dev/null; do
		iptables -t mangle -D FORWARD -j "$AC_CHAIN"
	done
	iptables -t mangle -F "$AC_CHAIN" 2>/dev/null
	iptables -t mangle -X "$AC_CHAIN" 2>/dev/null
}

# 重定向到本地 123 才有意义
#
# 另外把 NTP 上游换成国内源。道理很直接：所有"按时间比对"的检测（时钟偏移、
# 证书/HTTP Date 与包时间不符）都建立在路由器自己时钟准确的前提上；而
# *.openwrt.pool.ntp.org 在国内经常解析失败或超时，时钟一歪反而更容易被抓。
# 只在仍是默认池时才改，用户自定义过就不动。
ensure_ntpserver() {
	on ntp_local || return 0

	if [ "$(uci -q get system.ntp.enable_server)" != "1" ]; then
		uci -q set system.ntp.enable_server='1'
		uci -q commit system
		/etc/init.d/sysntpd reload 2>/dev/null || /etc/init.d/sysntpd restart 2>/dev/null
		log "system.ntp.enable_server=1 并重启 ntpd"
	fi

	case "$(uci -q get system.ntp.server)" in
	*openwrt.pool.ntp.org*)
		uci -q delete system.ntp.server
		for s in ntp.aliyun.com time1.cloud.tencent.com cn.pool.ntp.org stdtime.gov.hk; do
			uci -q add_list system.ntp.server="$s"
		done
		uci -q commit system
		/etc/init.d/sysntpd reload 2>/dev/null || /etc/init.d/sysntpd restart 2>/dev/null
		log "NTP 上游换成国内源：$(uci -q get system.ntp.server)"
		;;
	esac
}

# dnsmasq canary：Firefox 在启用 DoH 前会先查 use-application-dns.net，
# 拿到 NXDOMAIN 就自动关掉 DoH。零成本，顺手做掉。
ensure_canary() {
	uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1 || return 0
	if uci -q get dhcp.@dnsmasq[0].address 2>/dev/null | grep -q 'use-application-dns.net'; then
		return 0
	fi
	uci -q add_list dhcp.@dnsmasq[0].address='/use-application-dns.net/'
	uci -q commit dhcp
	/etc/init.d/dnsmasq reload 2>/dev/null
	log "canary: use-application-dns.net -> NXDOMAIN（Firefox 自动关 DoH）"
}

start() {
	if [ "$(c enabled)" != "1" ]; then
		rules_down
		log "ganyu.main.enabled != 1，未启用"
		return 0
	fi
	rules_up
	ensure_ntpserver
	ensure_canary
}

stop() {
	rules_down
}

restart() {
	stop
	start
}

status() {
	echo "== nft 表 ip $TABLE =="
	nft list table ip "$TABLE" 2>/dev/null || echo "（不存在，未启用？）"
	echo
	echo "== nft 表 ip6 $TABLE（IPv6 转发封锁）=="
	nft list table ip6 "$TABLE" 2>/dev/null || echo "（不存在）"
	echo
	echo "== iptables AC 链 =="
	iptables -t mangle -L "$AC_CHAIN" -n -v 2>/dev/null || echo "（无）"
	echo
	echo "== ntpd =="
	echo "enable_server = $(uci -q get system.ntp.enable_server)"
	ps w 2>/dev/null | grep -c '[n]tpd'
	echo
	echo "== dnsmasq canary =="
	uci -q get dhcp.@dnsmasq[0].address 2>/dev/null || echo "（未设置）"
}
