#!/bin/sh /etc/rc.common
# 校园网门户自动登录守护（procd 托管）
#
# 注意：这里必须是 USE_PROCD=1（真 1）。rc.common 判断的是「变量非空」，
# 写 0 也会被当成 procd 模式，从而覆盖本脚本的 start()。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ybu-login

start_service() {
	local enabled
	enabled=$(uci -q get ybu.main.enabled)
	[ "$enabled" = "1" ] || {
		logger -t ybu-login "未启用（uci set ybu.main.enabled=1）"
		return 0
	}
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ybu
}
