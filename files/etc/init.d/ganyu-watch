#!/bin/sh /etc/rc.common
# ganyu-watch —— 后台体检 + 出事断网
#
# 必须 procd 托管：前台脚本里 sleep 60 会把 /etc/init.d/rcS 卡住，
# dnsmasq / firewall / uhttpd 全都排在它后面起不来（rkp-ipid-mark 那次踩过）。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ganyu-watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
