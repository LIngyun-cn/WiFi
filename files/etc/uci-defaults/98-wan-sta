#!/bin/sh
# WAN 接入方式选择：有线（eth0.1 插墙口）还是无线 STA（radio1 连校园网 YBU）。
#
# 用 uci 里的 ybu.main.wan_mode 控制，默认 sta：
#   sta   —— 关掉有线口，用 phy1 的 STA 连 YBU，WAN 走无线
#   wired —— 关掉 STA，WAN 回到 eth0.1 走有线 DHCP
#
# 3A 的 phy1（MT76x2E，5G）同时跑 AP 和 STA 时受 #channels <= 1 限制，
# 必须同一个信道，所以 sta 模式下 radio1 的 channel 要设成 auto 让 hostapd 跟随 STA。
#
# 运行时切换用 `ybu-login mode sta|wired`，改完 reboot 生效
# （别用 wifi reload —— 这台 57MB 内存的机器 reload 会同时起两套 wpa_supplicant 直接 OOM）。

[ -f /etc/config/wireless ] || exit 0

mode=$(uci -q get ybu.main.wan_mode)
[ -n "$mode" ] || mode='sta'

# 起网门禁：把 WAN 的自动起网关掉，改由 ybu-wan-gate 在随机时刻 ifup。
# 只延迟"登录"没用 —— 没认证的设备照样会 DHCP/ARP，校园网侧一样看到
# 「每天 05:0x 准时出现」。这里连关联带 DHCP 一起推迟。
apply_gate() {
	case "$(uci -q get ybu.main.wan_gate)" in
	1 | '')
		uci -q set network.wan.auto='0'
		logger -t wan-sta "起网门禁开启：network.wan.auto=0，开机后等 ybu-wan-gate 随机时刻 ifup"
		;;
	*)
		uci -q set network.wan.auto='1'
		logger -t wan-sta "起网门禁关闭：network.wan.auto=1，开机立刻起网"
		;;
	esac
	uci -q commit network
}
if [ "$mode" = "wired" ]; then
	# 有线模式：WAN 绑定 eth0.1，STA 停用（两个 WAN 同时起来会抢默认路由）
	uci -q set network.wan.device='eth0.1'
	uci -q set network.wan.proto='dhcp'
	uci -q commit network
	if uci -q get wireless.wan_sta >/dev/null 2>&1; then
		uci -q set wireless.wan_sta.disabled='1'
		uci -q commit wireless
	fi
	apply_gate
	logger -t wan-sta "WAN 模式 = wired（eth0.1 有线 DHCP，STA 已停用）"
	exit 0
fi

# ---- sta 模式 ----
if ! uci -q get wireless.wan_sta >/dev/null 2>&1; then
	uci set wireless.wan_sta=wifi-iface
	uci set wireless.wan_sta.device='radio1'
	uci set wireless.wan_sta.mode='sta'
	uci set wireless.wan_sta.ssid='YBU'
	uci set wireless.wan_sta.encryption='none'
	uci set wireless.wan_sta.network='wan'
	uci set wireless.wan_sta.disabled='0'
	uci commit wireless
	logger -t wan-sta "已创建 wireless.wan_sta（radio1 -> YBU）"
fi

# WAN 不再绑有线口，交给无线 STA 做 dhcp 客户端
uci -q delete network.wan.device
uci -q set network.wan.proto='dhcp'
if uci -q get network.wan.ifname >/dev/null 2>&1; then
	uci -q delete network.wan.ifname
fi
uci -q commit network

# AP 与 STA 同 phy，必须同信道
[ "$(uci -q get wireless.radio1.channel)" != "auto" ] && {
	uci set wireless.radio1.channel='auto'
	uci commit wireless
}

apply_gate

exit 0

