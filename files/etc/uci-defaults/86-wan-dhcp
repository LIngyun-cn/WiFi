#!/bin/sh
# WAN 侧 DHCP 客户端指纹。
#
# 网关看 DHCP 请求（DISCOVER/REQUEST）时，除了 MAC 还能看到这些字段，
# 而它们基本等于"报自己是谁"：
#
#   option 12 hostname       busybox 默认发 /proc/sys/kernel/hostname。
#                            这台机器出厂是 OpenWrt → 直接自曝。已由
#                            89-wan-hostname 改成 PC 的名字。
#   option 60 vendor-class   真 Windows 发 "MSFT 5.0"，busybox udhcpc
#                            默认一个字节都不发 → "不知道是什么系统"
#                            本身就是异常。这里补上。
#   option 55 param-request  客户端想要的参数列表是有顺序的，Windows 和
#                            Linux 的清单明显不同。udhcpc 默认那串不像任何
#                            真实 PC，这里换成 Windows 10/11 的清单，
#                            并用 defaultreqopts=0 关掉 busybox 的默认追加。
#
# 这些只是"看起来像 Windows 笔记本"，不是银弹：真正的 Windows 还会带
# option 61 client-id 的特定前缀、option 43 vendor-specific 应答处理等。
# 但把最明显的三处对齐之后，DHCP 这一层就不再是"一眼 Linux"。

HN=$(uci -q get system.@system[0].hostname)
[ -n "$HN" ] || HN='DESKTOP-5G4QQFQ'

uci -q set network.wan.hostname="$HN"
uci -q set network.wan.vendorid='MSFT 5.0'
uci -q set network.wan.defaultreqopts='0'

uci -q delete network.wan.reqopts
for o in 1 3 6 15 31 33 43 44 46 47 119 121 249 252; do
	uci -q add_list network.wan.reqopts="$o"
done

uci -q commit network
logger -t wan-dhcp "DHCP 指纹对齐：hostname=$HN vendorid=MSFT 5.0 reqopts=Windows 清单"

exit 0
