#!/bin/sh
#
# WAN / AP 的 MAC 地址处理 —— 现在是「什么都不做」。
#
# ★★ 硬限制（2026-11-25 本机 A/B 实测，别再来一次）★★
#   这颗网卡是 MT76x2E（phy1，5G）。只要给 phy1 上的任何 vif 指定自定义 MAC
#   （不管是 AP 的 default_radio1.macaddr，还是 STA 的 wan_sta.macaddr），
#   5G 射频就整个发不出包：
#       hostapd: handle_probe_req: send failed      ← AP 连 beacon/probe 都发不出去
#       iwinfo radio1: ESSID: unknown  HT Mode: NOHT
#       wpa_supplicant: authentication with xx:xx:.. timed out
#       CTRL-EVENT-SSID-TEMP-DISABLED ... reason=CONN_FAILED
#   表现是：自家 Wi-Fi 还在广播、电脑能连上（2.4G 正常），但 WAN（走 phy1 的
#   STA）永远拿不到 IP，看起来就像「固件刷坏了 / 没网了」。
#   把 macaddr 全部删掉、用硬件默认地址重启，3 分钟内一切恢复正常。
#   两次独立复现：
#     ① AP + STA 同时覆盖 MAC  → 坏
#     ② 只覆盖 STA 的 MAC      → 坏
#     ③ 全部用硬件默认 MAC     → 好
#   结论：MAC 克隆 / BSSID 去小米化 在这台机器上不可实现，不是配置问题。
#
# 背景（当初为什么想改）：WAN 侧原 MAC 是 50:64:2b:xx —— 小米 OUI，网关一眼
# 就知道链路上是台小米路由器；AP 的 BSSID 同样是 50:64:2b:xx。这两条都是
# 真实存在的指纹，但代价是整台机器断网，所以放弃。
#
# 想要「换 MAC」只有两条路，都不在本固件范围内：
#   1) 换一颗驱动允许 per-vif MAC 的无线网卡（例如 USB 网卡做 STA）；
#   2) 用有线做 WAN，然后只改 network.wan.macaddr —— eth0 是有线口，
#      不受 mt76x2 的限制（但要自己承担「改了 MAC 就要重新过门户认证」）。
#
# 因此本脚本保留 ybu.main.wan_mac 这个 uci 字段（仅为以后换硬件时留接口），
# 但绝不写进 network.wan.macaddr / wireless.wan_sta.macaddr，
# 也绝不设 wireless.default_radio*.macaddr。

MAC=$(uci -q get ybu.main.wan_mac)
if [ -n "$MAC" ]; then
	logger -t macclone "检测到 ybu.main.wan_mac=$MAC，但本机 MT76x2E 不支持自定义 vif MAC，已忽略"
fi

exit 0
