#!/bin/sh
# WAN 口 MAC 处理。
#
# 两件事：
#   1) 没指定 MAC 时，自动生成一个"普通笔记本"的 MAC 并固定下来。
#      为什么必须做：这台机器 WAN 侧原本是 50:64:2b:xx —— 小米 OUI，
#      网关只要看一眼 MAC 前缀就知道"链路上是一台小米路由器"，
#      比任何协议层指纹都直接、也不可能靠改配置绕过去。
#   2) 把 MAC 同时写进 network.wan.macaddr 和 wireless.wan_sta.macaddr。
#      WAN 走无线 STA 时，netifd 管的是逻辑接口，vif 的 MAC 由
#      wpa_supplicant 设，两处不一致就会出现"网卡是一个 MAC、
#      门户记录是另一个 MAC"。
#
# 想指定成你 PC 的 MAC（复用已有认证记录）：
#   uci set ybu.main.wan_mac='AA:BB:CC:DD:EE:FF'
#   uci commit ybu
#   reboot
#
# 注意：MAC 只认第一次认证时绑定的那个；改完必须重启让 netifd 重设网卡地址。

MAC=$(uci -q get ybu.main.wan_mac)

if [ -z "$MAC" ]; then
	# Intel OUI 3c:a9:f4 —— 笔记本里最常见的几个前缀之一。
	# 用 /dev/urandom 取后三段；生成一次就写进 uci，之后每次开机都是同一个，
	# 不会因为重启而被网关当成"新设备"。
	tail=$(hexdump -n 3 -e '3/1 "%02x"' /dev/urandom 2>/dev/null)
	case "$tail" in
	[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
	*) tail=$(awk 'BEGIN { srand(); printf "%06x", int(rand() * 16777216) }') ;;
	esac
	MAC="3c:a9:f4:$(echo "$tail" | cut -c1-2):$(echo "$tail" | cut -c3-4):$(echo "$tail" | cut -c5-6)"
	uci -q set ybu.main.wan_mac="$MAC"
	uci -q commit ybu
	logger -t macclone "WAN MAC 未指定，自动生成 $MAC（重启后生效）"
fi

case "$MAC" in
*:*:*:*:*:*) ;;
*) exit 0 ;;
esac

current=$(uci -q get network.wan.macaddr)
if [ "$current" != "$MAC" ]; then
	uci -q set network.wan.macaddr="$MAC"
	uci -q commit network
	logger -t macclone "WAN MAC -> $MAC（重启后生效）"
fi

if uci -q get wireless.wan_sta >/dev/null 2>&1; then
	cur2=$(uci -q get wireless.wan_sta.macaddr)
	if [ "$cur2" != "$MAC" ]; then
		uci -q set wireless.wan_sta.macaddr="$MAC"
		uci -q commit wireless
		logger -t macclone "STA MAC -> $MAC（重启后生效）"
	fi
fi

# 自己开的 AP 同样在自报 MIB：BSSID 原来是 50:64:2B:C1:00:56 / :57，
# 和小米出厂网卡同 OUI。学校查"私接路由器"时是用巡测/嗅探扫 2.4G/5G 的，
# 扫到一个小米 OUI 的 BSSID 就等于当场抓到人 —— 这跟"多设备检测"是两码事，
# 但后果更直接（通报/断网）。
# 这里把两个 AP 的 BSSID 也换成克隆 MAC 的 OUI，看起来就是"某台笔记本开的
# 移动热点" —— Windows 移动热点本来就直接拿网卡 MAC 当 BSSID。
#
# ★ 血泪教训（v9 线上实测）：AP 和 STA 跑在同一个 phy1 上。
#   如果算出来的 AP 地址正好等于 STA 的 MAC，内核会让 phy1-sta0 起不来：
#       wpa_supplicant: Could not set interface phy1-sta0 flags (UP)
#       wpa_supplicant: nl80211: Could not set interface 'phy1-sta0' UP
#       wpa_supplicant: phy1-sta0: Failed to initialize driver interface
#   后果就是 AP 亮着、WAN 全断（拿不到 DHCP、也没法登录门户），
#   现场看起来像"固件坏了"。所以下面必须保证 AP 地址 ≠ WAN/STA 地址。
APOUI=$(echo "$MAC" | cut -d: -f1-3)
AP4=$(echo "$MAC" | cut -d: -f4)
AP5=$(echo "$MAC" | cut -d: -f5)

ap_mac_for() {
	_m="$APOUI:$AP4:$AP5:$(printf '%02x' "$1")"
	if [ "$_m" = "$MAC" ]; then
		# 撞上了 WAN/STA 的 MAC，往后挪一个
		_m="$APOUI:$AP4:$AP5:$(printf '%02x' "$(( $1 + 1 ))")"
	fi
	printf '%s' "$_m"
}

set_ap_mac() {
	_want=$(ap_mac_for "$2")
	[ -n "$(uci -q get "wireless.$1")" ] || return 0
	[ "$(uci -q get "wireless.$1.macaddr")" = "$_want" ] && return 0
	uci -q set "wireless.$1.macaddr=$_want"
	logger -t macclone "AP BSSID $1 -> $_want（重启后生效）"
}

set_ap_mac default_radio0 86	# 0x56
set_ap_mac default_radio1 87	# 0x57
uci -q commit wireless

exit 0
