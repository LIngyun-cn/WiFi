# 首次启动执行一次：语言、无线、区域
# 只在 SSID 还是 OpenWrt 默认值/空的时候才写，避免 sysupgrade 后被覆盖回默认名
uci -q set luci.main.lang=zh_cn

uci -q set wireless.radio0.disabled='0'
uci -q set wireless.radio1.disabled='0'
uci -q set wireless.radio0.country='CN'
uci -q set wireless.radio1.country='CN'

SSID='Ciallo～(∠・ω< )⌒★'
PSK='0d00@0721'

for s in default_radio0 default_radio1; do
	cur=$(uci -q get "wireless.$s.ssid")
	case "$cur" in
		''|OpenWrt*)
			uci -q set "wireless.$s.ssid=$SSID"
			uci -q set "wireless.$s.encryption='psk2'"
			uci -q set "wireless.$s.key=$PSK"
			;;
	esac
done

uci commit

# 改 root 密码（明文只在这台设备首次启动时用到一次，脚本执行后会被删）
# echo -e 'yourpassword\nyourpassword' | passwd root

exit 0
